<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+ backups and device-to-device transfer: the same as backup_rules.xml. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="cloud.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="cloud.xml" />
    </device-transfer>
</data-extraction-rules>
