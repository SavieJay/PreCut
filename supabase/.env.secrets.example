# Secrets for the `cloud` Edge Function (docs/CLOUD_API.md). The filled-in copy is
# supabase/.env.secrets, which is gitignored; it is sent to your Supabase project with
#   npx supabase secrets set --env-file supabase/.env.secrets
# and is never committed or printed.

# ElevenLabs API key for Scribe v2 (speech to text). Paste it after the "=".
ELEVENLABS_API_KEY=

# true only if your ElevenLabs plan includes zero-retention mode (enterprise plans).
ELEVENLABS_ZERO_RETENTION=false

# The Google Cloud service-account key for Play Integrity, as one line of JSON in single quotes.
# Written from the downloaded key file without showing it on screen (see docs/CLOUD_API.md, Setup).
GOOGLE_SERVICE_ACCOUNT_JSON=

# Signs install tokens: a long random string, generated into the file (see docs/CLOUD_API.md, Setup).
INSTALL_TOKEN_SECRET=

# SHA-256 of every certificate PreCut is signed with (debug, upload, Play app signing), comma-separated,
# hex or base64. Not secret: read from the built APKs with apksigner.
PLAY_CERT_SHA256=

# AI edits (Phase 22C): an Anthropic API key. Without it, AI edits answer "not_configured" and
# everything else keeps working. Paste it after the "=".
ANTHROPIC_API_KEY=

# Optional: the Claude model for AI edits (default claude-opus-5-5) and how hard it thinks
# (low, medium, high, xhigh or max; default medium).
# ANTHROPIC_MODEL=claude-opus-5-5
# ANTHROPIC_EFFORT=medium
