[
  {
    "name": "trim_clip",
    "description": "Keep only part of a main-track clip's media: from keep_from_seconds to keep_to_seconds of its source (the brief gives each clip's source_seconds and current keep range). Photos have no source length: their kept length is how long they show.",
    "strict": true,
    "input_schema": {
      "type": "object",
      "properties": {
        "clip_id": {
          "type": "string"
        },
        "keep_from_seconds": {
          "type": "number"
        },
        "keep_to_seconds": {
          "type": "number"
        }
      },
      "required": [
        "clip_id",
        "keep_from_seconds",
        "keep_to_seconds"
      ],
      "additionalProperties": false
    }
  },
  {
    "name": "split_clip",
    "description": "Cut a main-track clip in two at at_seconds into the clip as it plays (0 is its start on the timeline). The result names the new second part's id.",
    "strict": true,
    "input_schema": {
      "type": "object",
      "properties": {
        "clip_id": {
          "type": "string"
        },
        "at_seconds": {
          "type": "number"
        }
      },
      "required": [
        "clip_id",
        "at_seconds"
      ],
      "additionalProperties": false
    }
  },
  {
    "name": "delete_clips",
    "description": "Remove main-track clips. At least one clip must stay on the main track.",
    "strict": true,
    "input_schema": {
      "type": "object",
      "properties": {
        "clip_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "clip_ids"
      ],
      "additionalProperties": false
    }
  },
  {
    "name": "move_clip",
    "description": "Move a main-track clip to position to_position (0 is first) among the main-track clips.",
    "strict": true,
    "input_schema": {
      "type": "object",
      "properties": {
        "clip_id": {
          "type": "string"
        },
        "to_position": {
          "type": "integer"
        }
      },
      "required": [
        "clip_id",
        "to_position"
      ],
      "additionalProperties": false
    }
  },
  {
    "name": "duplicate_clip",
    "description": "Copy a main-track clip, with all its settings, right after itself. The result names the copy's id.",
    "strict": true,
    "input_schema": {
      "type": "object",
      "properties": {
        "clip_id": {
          "type": "string"
        }
      },
      "required": [
        "clip_id"
      ],
      "additionalProperties": false
    }
  },
  {
    "name": "set_clip_speed",
    "description": "Play a video clip faster or slower: speed 0.1 to 100 (1 is normal). The clip's length on the timeline changes with it. Photos have no speed.",
    "strict": true,
    "input_schema": {
      "type": "object",
      "properties": {
        "clip_id": {
          "type": "string"
        },
        "speed": {
          "type": "number"
        }
      },
      "required": [
        "clip_id",
        "speed"
      ],
      "additionalProperties": false
    }
  },
  {
    "name": "set_clip_sound",
    "description": "A clip's own sound: volume_percent 0 to 200, muted, and fades in seconds. Leave a value out (or null) to keep it as it is.",
    "strict": false,
    "input_schema": {
      "type": "object",
      "properties": {
        "clip_id": {
          "type": "string"
        },
        "volume_percent": {
          "type": [
            "number",
            "null"
          ]
        },
        "muted": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "fade_in_seconds": {
          "type": [
            "number",
            "null"
          ]
        },
        "fade_out_seconds": {
          "type": [
            "number",
            "null"
          ]
        }
      },
      "required": [
        "clip_id"
      ],
      "additionalProperties": false
    }
  },
  {
    "name": "set_clip_look",
    "description": "A clip's colour: a filter from catalog.filters (filter_id; \"none\" removes it) at filter_strength_percent 0 to 100, and adjustments from -100 to 100 (vignette 0 to 100). Leave a value out (or null) to keep it as it is.",
    "strict": false,
    "input_schema": {
      "type": "object",
      "properties": {
        "clip_id": {
          "type": "string"
        },
        "filter_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "filter_strength_percent": {
          "type": [
            "number",
            "null"
          ]
        },
        "brightness": {
          "type": [
            "number",
            "null"
          ]
        },
        "contrast": {
          "type": [
            "number",
            "null"
          ]
        },
        "saturation": {
          "type": [
            "number",
            "null"
          ]
        },
        "exposure": {
          "type": [
            "number",
            "null"
          ]
        },
        "temperature": {
          "type": [
            "number",
            "null"
          ]
        },
        "vignette": {
          "type": [
            "number",
            "null"
          ]
        }
      },
      "required": [
        "clip_id"
      ],
      "additionalProperties": false
    }
  },
  {
    "name": "set_transition",
    "description": "The transition from a main-track clip into the next one: a type from catalog.transitions (\"none\" removes it) lasting duration_seconds (0.1 to 2; null keeps its current length, or 0.5). Overlapping types make the video shorter by their length.",
    "strict": true,
    "input_schema": {
      "type": "object",
      "properties": {
        "after_clip_id": {
          "type": "string"
        },
        "transition": {
          "type": "string"
        },
        "duration_seconds": {
          "type": [
            "number",
            "null"
          ]
        }
      },
      "required": [
        "after_clip_id",
        "transition",
        "duration_seconds"
      ],
      "additionalProperties": false
    }
  },
  {
    "name": "set_clip_animation",
    "description": "How a clip enters and leaves: in and out animations from catalog.animations, or a looping combo from catalog.combos that replaces them. \"none\" removes one; leaving one out (or null) keeps it as it is. Durations in seconds (left out or null keeps the default).",
    "strict": false,
    "input_schema": {
      "type": "object",
      "properties": {
        "clip_id": {
          "type": "string"
        },
        "in_animation": {
          "type": [
            "string",
            "null"
          ]
        },
        "out_animation": {
          "type": [
            "string",
            "null"
          ]
        },
        "combo": {
          "type": [
            "string",
            "null"
          ]
        },
        "in_seconds": {
          "type": [
            "number",
            "null"
          ]
        },
        "out_seconds": {
          "type": [
            "number",
            "null"
          ]
        }
      },
      "required": [
        "clip_id"
      ],
      "additionalProperties": false
    }
  },
  {
    "name": "add_text",
    "description": "Add a text on the video from start_seconds to end_seconds of the timeline, near the top, middle or bottom, optionally styled with a template from catalog.text_templates. The result names the text's id.",
    "strict": true,
    "input_schema": {
      "type": "object",
      "properties": {
        "text": {
          "type": "string"
        },
        "start_seconds": {
          "type": "number"
        },
        "end_seconds": {
          "type": "number"
        },
        "position": {
          "type": "string",
          "enum": [
            "top",
            "middle",
            "bottom"
          ]
        },
        "template_id": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "text",
        "start_seconds",
        "end_seconds",
        "position",
        "template_id"
      ],
      "additionalProperties": false
    }
  },
  {
    "name": "edit_text",
    "description": "Change a text's words or timing (timeline seconds). Null leaves a value as it is.",
    "strict": true,
    "input_schema": {
      "type": "object",
      "properties": {
        "text_id": {
          "type": "string"
        },
        "text": {
          "type": [
            "string",
            "null"
          ]
        },
        "start_seconds": {
          "type": [
            "number",
            "null"
          ]
        },
        "end_seconds": {
          "type": [
            "number",
            "null"
          ]
        }
      },
      "required": [
        "text_id",
        "text",
        "start_seconds",
        "end_seconds"
      ],
      "additionalProperties": false
    }
  },
  {
    "name": "delete_texts",
    "description": "Remove texts or stickers.",
    "strict": true,
    "input_schema": {
      "type": "object",
      "properties": {
        "text_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "text_ids"
      ],
      "additionalProperties": false
    }
  },
  {
    "name": "add_effect",
    "description": "Add a video effect from catalog.effects over everything from start_seconds to end_seconds of the timeline, at intensity_percent 0 to 100.",
    "strict": true,
    "input_schema": {
      "type": "object",
      "properties": {
        "effect_id": {
          "type": "string"
        },
        "start_seconds": {
          "type": "number"
        },
        "end_seconds": {
          "type": "number"
        },
        "intensity_percent": {
          "type": "number"
        }
      },
      "required": [
        "effect_id",
        "start_seconds",
        "end_seconds",
        "intensity_percent"
      ],
      "additionalProperties": false
    }
  },
  {
    "name": "set_aspect_ratio",
    "description": "The video's shape.",
    "strict": true,
    "input_schema": {
      "type": "object",
      "properties": {
        "ratio": {
          "type": "string",
          "enum": [
            "original",
            "9:16",
            "16:9",
            "1:1",
            "4:5",
            "4:3",
            "3:4",
            "2:1",
            "2.35:1",
            "1.85:1",
            "9:19.5"
          ]
        }
      },
      "required": [
        "ratio"
      ],
      "additionalProperties": false
    }
  },
  {
    "name": "set_audio_track",
    "description": "An audio clip (music, voiceover, extracted sound): volume_percent 0 to 200, fades in seconds, and where it starts on the timeline. Leave a value out (or null) to keep it as it is.",
    "strict": false,
    "input_schema": {
      "type": "object",
      "properties": {
        "audio_id": {
          "type": "string"
        },
        "volume_percent": {
          "type": [
            "number",
            "null"
          ]
        },
        "fade_in_seconds": {
          "type": [
            "number",
            "null"
          ]
        },
        "fade_out_seconds": {
          "type": [
            "number",
            "null"
          ]
        },
        "start_seconds": {
          "type": [
            "number",
            "null"
          ]
        }
      },
      "required": [
        "audio_id"
      ],
      "additionalProperties": false
    }
  },
  {
    "name": "cut_to_beats",
    "description": "Trim the main-track clips so each change lands on a beat of a music clip that has beats (the brief gives each audio clip's beat count). Works only when that music has beats marked.",
    "strict": true,
    "input_schema": {
      "type": "object",
      "properties": {
        "audio_id": {
          "type": "string"
        }
      },
      "required": [
        "audio_id"
      ],
      "additionalProperties": false
    }
  },
  {
    "name": "remove_time_ranges",
    "description": "Cut stretches out of the whole video (start_seconds to end_seconds of the timeline), closing the gaps: pauses, silences, false starts, dull parts. Clips, captions, texts and voiceovers stay in line; music plays on. Use the brief's media.loudness_per_second, media.lines and media.shots to choose. The result gives the new timeline.",
    "strict": true,
    "input_schema": {
      "type": "object",
      "properties": {
        "ranges": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "start_seconds": {
                "type": "number"
              },
              "end_seconds": {
                "type": "number"
              }
            },
            "required": [
              "start_seconds",
              "end_seconds"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "ranges"
      ],
      "additionalProperties": false
    }
  },
  {
    "name": "add_captions",
    "description": "Ask for automatic captions of what's said, in a style from catalog.caption_styles. They're made after the person applies your changes (the sound is sent for speech-to-text only with their consent), so don't add texts for the words yourself.",
    "strict": true,
    "input_schema": {
      "type": "object",
      "properties": {
        "style": {
          "type": "string"
        }
      },
      "required": [
        "style"
      ],
      "additionalProperties": false
    }
  }
]
